{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ralph.local/schema/ralph-plan.schema.json",
  "title": "Ralph Plan schemaVersion 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "branchName",
    "description",
    "userStories"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "branchName": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "userStories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/story" }
    }
  },
  "$defs": {
    "nonemptyString": { "type": "string", "minLength": 1 },
    "nonemptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonemptyString" }
    },
    "stringArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonemptyString" }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "acceptanceCriteria",
        "nonGoals",
        "checks",
        "references",
        "dependencies",
        "priority",
        "passes",
        "notes"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonemptyString" },
        "title": { "$ref": "#/$defs/nonemptyString" },
        "description": { "$ref": "#/$defs/nonemptyString" },
        "acceptanceCriteria": { "$ref": "#/$defs/nonemptyStringArray" },
        "nonGoals": { "$ref": "#/$defs/stringArray" },
        "checks": { "$ref": "#/$defs/nonemptyStringArray" },
        "references": { "$ref": "#/$defs/nonemptyStringArray" },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonemptyString" }
        },
        "priority": { "type": "integer", "minimum": 1 },
        "passes": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    }
  }
}
