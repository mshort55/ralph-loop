{
  "name": "ralph-loop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ralph": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "resources",
    "schema",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepack": "npm run check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' '*.json' '*.ts' 'schema/*.json'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' '*.json' '*.ts' 'schema/*.json'",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run typecheck && npm run test:coverage && npm run build"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "proper-lockfile": "^4.1.2",
    "zx": "^8.8.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/proper-lockfile": "^4.1.4",
    "@vitest/coverage-v8": "^5.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
