#!/usr/bin/env bash
# Fake Codex for Ralph fixtures. Never talks to the network.
set -euo pipefail

if [[ -z "${RALPH_FAKE_STATE:-}" ]]; then
  echo "fake-codex: RALPH_FAKE_STATE is required" >&2
  exit 90
fi

mkdir -p "$RALPH_FAKE_STATE"

if [[ "${1:-}" == "login" ]]; then
  if [[ "${RALPH_FAKE_LOGIN_FAIL:-0}" == "1" ]]; then
    exit 1
  fi
  echo "logged in"
  exit 0
fi

count_file="$RALPH_FAKE_STATE/count"
count=0
if [[ -f "$count_file" ]]; then
  count=$(cat "$count_file")
fi
count=$((count + 1))
echo "$count" >"$count_file"
sed -n '/^CapInh:/p;/^CapAmb:/p' /proc/self/status >"$RALPH_FAKE_STATE/caps.$count"

printf '%s\0' "$@" >"$RALPH_FAKE_STATE/args.$count"
: >"$RALPH_FAKE_STATE/argv.$count"
for arg in "$@"; do
  printf '%s\n' "$arg" >>"$RALPH_FAKE_STATE/argv.$count"
done

prompt_file="$RALPH_FAKE_STATE/prompt.$count"
cat >"$prompt_file"

cd_path=""
prev=""
for arg in "$@"; do
  if [[ "$prev" == "--cd" ]]; then
    cd_path=$arg
  fi
  prev=$arg
done
if [[ -n "$cd_path" ]]; then
  cd "$cd_path"
fi

echo "{\"type\":\"fake\",\"iteration\":$count}"

if [[ -x "$RALPH_FAKE_STATE/hook" ]]; then
  "$RALPH_FAKE_STATE/hook" "$count"
fi
